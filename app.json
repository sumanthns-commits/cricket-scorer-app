{
  "expo": {
    "name": "Crease",
    "slug": "cricket-scorer-app",
    "scheme": "cricket-scorer-app",
    "version": "2.8.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crease.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.crease.cricket",
      "versionCode": 39,
      "adaptiveIcon": {
        "backgroundColor": "#16a34a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiKey": {},
      "eas": {
        "projectId": "1483b1e4-d5e3-49ce-a2bc-8cf779606d0d"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-dev-client",
      "expo-localization",
      "expo-font",
      "expo-apple-authentication",
      ["@react-native-google-signin/google-signin", {
        "iosUrlScheme": "com.googleusercontent.apps.29441644794-5937grt2lqfvgg0r9i29mmpdcpgrog9n"
      }],
      ["expo-notifications", {
        "icon": "./assets/android-icon-monochrome.png",
        "color": "#16a34a",
        "defaultChannel": "default"
      }],
      "./plugins/withReleaseSigningConfig"
    ],
    "owner": "sumanthns-commits"
  }
}
